# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudinary Configuration
# Users obtain these from their Cloudinary Console dashboard
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_API_KEY"
CLOUDINARY_API_SECRET="YOUR_API_SECRET"

# SSLCommerz Payment Gateway Configuration (Standard for Bangladesh Cards/bKash/Nagad)
# Set SSLCOMMERZ_IS_SANDBOX to "false" in your real production settings to go live.
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="testbox@ssl"
SSLCOMMERZ_IS_SANDBOX="true"
PAYMENT_FALLBACK_EMAIL="noreply@example.com"

# SMS Gateway Configuration (Optional - Can also be configured directly via Admin Dashboard)
SMS_ENABLED="false"
SMS_PROVIDER="greenweb"
SMS_API_KEY=""
SMS_SENDER_ID="MAGMATI"

# Email Gateway Configuration (Optional - Can also be configured directly via Admin Dashboard)
EMAIL_ENABLED="false"
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="orders@magmati.com"

# Firebase & Firestore Database Credentials
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""

# Google Workspace & OAuth Login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Courier Logistics
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
REDX_API_TOKEN=""

# Server-Side Admin Authorization (Comma-separated list of administrative emails)
ADMIN_EMAILS="admin@example.com"

